{
  "name": "@menhir/bundle-size",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "size": "pnpm --filter menhir build && size-limit",
    "size:json": "pnpm --filter menhir build && mkdir -p dist && size-limit --json > dist/sizes.json",
    "test": "pnpm --filter menhir build && vitest"
  },
  "dependencies": {
    "menhir": "workspace:*"
  },
  "devDependencies": {
    "@size-limit/file": "~14.3.0",
    "@size-limit/rolldown": "~14.3.0",
    "@types/node": "^26.6.6",
    "rolldown": "~1.2.19",
    "size-limit": "~14.3.0",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  }
}
