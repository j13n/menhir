{
  // Shared compiler options for every workspace package. Each package extends
  // this and adds what it needs, such as `include` or `types`. The base only
  // typechecks; a package that emits overrides `noEmit`.
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // Relative imports name the source file (`./x.tsx`). A package that emits
    // gets them rewritten to the output name (`./x.jsx`) in its JavaScript; .d.ts
    // files keep the source name, which resolves to the .d.ts next to it.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true
  }
}
