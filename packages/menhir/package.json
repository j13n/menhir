{
  "name": "menhir",
  "version": "0.1.3",
  "description": "Unstyled, accessible UI primitives for SolidJS 2.0, with small and measurable bundles",
  "keywords": [
    "solid",
    "solidjs",
    "solid-js",
    "ui",
    "headless",
    "unstyled",
    "accessible",
    "primitives",
    "components"
  ],
  "license": "MIT",
  "homepage": "https://menhir-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j13n/menhir.git",
    "directory": "packages/menhir"
  },
  "bugs": "https://github.com/j13n/menhir/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./accordion": {
      "types": "./dist/source/accordion/index.d.ts",
      "solid": "./dist/source/accordion/index.js",
      "import": "./dist/accordion/index.js"
    },
    "./alert-dialog": {
      "types": "./dist/source/alert-dialog/index.d.ts",
      "solid": "./dist/source/alert-dialog/index.js",
      "import": "./dist/alert-dialog/index.js"
    },
    "./checkbox": {
      "types": "./dist/source/checkbox/index.d.ts",
      "solid": "./dist/source/checkbox/index.js",
      "import": "./dist/checkbox/index.js"
    },
    "./collapsible": {
      "types": "./dist/source/collapsible/index.d.ts",
      "solid": "./dist/source/collapsible/index.js",
      "import": "./dist/collapsible/index.js"
    },
    "./color-scheme/cookie": {
      "types": "./dist/source/color-scheme/cookie/index.d.ts",
      "solid": "./dist/source/color-scheme/cookie/index.js",
      "import": "./dist/color-scheme/cookie/index.js"
    },
    "./color-scheme/local-storage": {
      "types": "./dist/source/color-scheme/local-storage/index.d.ts",
      "solid": "./dist/source/color-scheme/local-storage/index.js",
      "import": "./dist/color-scheme/local-storage/index.js"
    },
    "./dialog": {
      "types": "./dist/source/dialog/index.d.ts",
      "solid": "./dist/source/dialog/index.js",
      "import": "./dist/dialog/index.js"
    },
    "./meter": {
      "types": "./dist/source/meter/index.d.ts",
      "solid": "./dist/source/meter/index.js",
      "import": "./dist/meter/index.js"
    },
    "./navigation-menu": {
      "types": "./dist/source/navigation-menu/index.d.ts",
      "solid": "./dist/source/navigation-menu/index.js",
      "import": "./dist/navigation-menu/index.js"
    },
    "./popover": {
      "types": "./dist/source/popover/index.d.ts",
      "solid": "./dist/source/popover/index.js",
      "import": "./dist/popover/index.js"
    },
    "./progress": {
      "types": "./dist/source/progress/index.d.ts",
      "solid": "./dist/source/progress/index.js",
      "import": "./dist/progress/index.js"
    },
    "./separator": {
      "types": "./dist/source/separator/index.d.ts",
      "solid": "./dist/source/separator/index.js",
      "import": "./dist/separator/index.js"
    },
    "./switch": {
      "types": "./dist/source/switch/index.d.ts",
      "solid": "./dist/source/switch/index.js",
      "import": "./dist/switch/index.js"
    },
    "./theme/cookie": {
      "types": "./dist/source/theme/cookie/index.d.ts",
      "solid": "./dist/source/theme/cookie/index.js",
      "import": "./dist/theme/cookie/index.js"
    },
    "./theme/local-storage": {
      "types": "./dist/source/theme/local-storage/index.d.ts",
      "solid": "./dist/source/theme/local-storage/index.js",
      "import": "./dist/theme/local-storage/index.js"
    },
    "./tabs": {
      "types": "./dist/source/tabs/index.d.ts",
      "solid": "./dist/source/tabs/index.js",
      "import": "./dist/tabs/index.js"
    },
    "./toggle": {
      "types": "./dist/source/toggle/index.d.ts",
      "solid": "./dist/source/toggle/index.js",
      "import": "./dist/toggle/index.js"
    },
    "./toggle-group": {
      "types": "./dist/source/toggle-group/index.d.ts",
      "solid": "./dist/source/toggle-group/index.js",
      "import": "./dist/toggle-group/index.js"
    },
    "./tooltip": {
      "types": "./dist/source/tooltip/index.d.ts",
      "solid": "./dist/source/tooltip/index.js",
      "import": "./dist/tooltip/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "imports": {
    "#test-utils": "./test/index.ts"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check:package": "pnpm build && publint --strict && attw --pack . --profile esm-only",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "test": "vitest",
    "test:chromium": "VITEST_ENV=chromium vitest",
    "test:package": "pnpm build && vitest run --config vitest.package.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@solidjs/diagnostics": "^2.0.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "solid-js": "^2.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  }
}
