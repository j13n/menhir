// The docs site on Cloudflare Workers static assets (PLAN.md section 3).
// `vite build` prerenders every page into dist/client, and the
// "Deploy docs site" job in .github/workflows/ci.yml deploys it from main.
{
  "name": "menhir-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/client",
    // Every page is prerendered to a file, so a path without one does not
    // exist: it gets 404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  // Served at menhir-ui.com only. Deploying creates the custom domain and its
  // DNS record, which needs the zone in this Cloudflare account. With a route
  // set, the workers.dev address is off.
  "routes": [{ "pattern": "menhir-ui.com", "custom_domain": true }],
}
