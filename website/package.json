    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/highlight": "^1.2.12",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.6.6",
    "filesystem-routing": "0.5.0",
    "jsdom": "^31.0.0",
    "magic-string": "^1.4.5",
    "prerender-crawler": "~0.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
